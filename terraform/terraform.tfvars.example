# =============================================================================
# Terraform variables example file
# Copy to terraform.tfvars and modify with your own values
# =============================================================================

resource_group_name = "rg-sockshop"
location            = "westeurope"
cluster_name        = "aks-sockshop"

# Kubernetes version (leave empty to use the AKS default)
kubernetes_version = ""

# Default node pool
node_count = 2
vm_size    = "Standard_B2s"

# Auto-scaling (optional)
enable_auto_scaling = false
min_node_count      = 1
max_node_count      = 5

# NGINX Ingress Controller
ingress_controller_enabled = true
ingress_nginx_namespace    = "ingress-nginx"

# Resource tags
tags = {
  environment = "demo"
  project     = "sock-shop"
}
