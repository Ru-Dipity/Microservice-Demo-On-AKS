# =============================================================================
# Terraform 变量示例文件
# 复制为 terraform.tfvars 并修改为你自己的值
# =============================================================================

resource_group_name = "rg-sockshop"
location            = "westeurope"
cluster_name        = "aks-sockshop"

# Kubernetes 版本（留空则使用 AKS 默认）
kubernetes_version = ""

# 默认节点池
node_count = 2
vm_size    = "Standard_B2s"

# 自动扩缩容（可选）
enable_auto_scaling = false
min_node_count      = 1
max_node_count      = 5

# NGINX Ingress Controller
ingress_controller_enabled = true
ingress_nginx_namespace    = "ingress-nginx"

# 资源标签
tags = {
  environment = "demo"
  project     = "sock-shop"
}
