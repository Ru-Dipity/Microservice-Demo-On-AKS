# -----------------------------------------------------------------------------
# Non-sensitive runtime configuration for the Sock Shop microservices.
# Kustomize consumes this file via configMapGenerator and mounts values into
# Pods as environment variables (see envFrom in each Deployment spec).
# DO NOT put passwords / tokens here — those go in 00-sock-shop-secret.yaml.
# -----------------------------------------------------------------------------

# --- Front-end / Node.js ----------------------------------------------------
# Enable Redis-backed session store (true) vs in-memory sessions (false).
SESSION_REDIS=true
# Session cookie TTL in seconds. 86400 = 24h.
SESSION_TTL=86400
# Structured JSON logging format for AKS Container Insights / Azure Monitor.
# Accepted values: json | text.  json is required for log query parsing.
LOG_FORMAT=json
LOG_LEVEL=info

# --- Java services (carts / orders / shipping / queue-master) ---------------
# Common JVM tuning for containerised workloads on AKS.
# -Xms matches initial heap; -Xmx caps max heap (leave headroom for metaspace).
JAVA_OPTS=-Xms64m -Xmx256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.security.egd=file:/dev/urandom
# Disable Zipkin tracing in the demo to reduce startup overhead (no collector runs).
SPRING_ZIPKIN_ENABLED=false
# Spring Boot Actuator endpoints for Prometheus scraping.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized

# --- Go services (catalogue / payment / user) -------------------------------
# Go runtime GOMAXPROCS. Leave empty to auto-detect from CPU cgroup limits (recommended).
GOMAXPROCS=
# Structured log level for Go services (debug | info | warn | error).
GO_LOG_LEVEL=info

# --- Database hostnames (DNS names of *-db Services inside the namespace) ---
# Spring Data MongoDB connection host components for Java services.
CARTS_DB_HOST=carts-db
CARTS_DB_PORT=27017
CARTS_DB_DATABASE=data
ORDERS_DB_HOST=orders-db
ORDERS_DB_PORT=27017
ORDERS_DB_DATABASE=data
# Go user service connection string components.
USER_DB_HOST=user-db
USER_DB_PORT=27017
USER_DB_DATABASE=socksdb
# Go catalogue service MariaDB DSN pieces.
CATALOGUE_DB_HOST=catalogue-db
CATALOGUE_DB_PORT=3306
CATALOGUE_DB_DATABASE=socksdb
# Redis session store for front-end.
SESSION_DB_HOST=session-db
SESSION_DB_PORT=6379
# RabbitMQ broker (shipping / queue-master / orders).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_AMQP_PORT=5672

# --- Prometheus / monitoring ------------------------------------------------
# Prometheus scrape label prefix. Used by Prometheus to discover service-level metrics.
PROMETHEUS_SCRAPE=true
# Default scrape interval hint; actual interval is set in Prometheus config.
METRICS_SCRAPE_INTERVAL=15s
